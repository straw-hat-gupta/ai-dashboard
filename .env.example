# Port the dashboard listens on
PORT=4200

# How often to poll Claude/Codex CLI usage (cron syntax). The usage endpoint
# rate-limits fairly aggressively, so every 5 minutes matches what similar
# tools use.
POLL_CRON=*/5 * * * *

# Path where the encrypted session data and SQLite DB live.
# Mount this as a volume so logins survive container restarts.
DATA_DIR=/data

